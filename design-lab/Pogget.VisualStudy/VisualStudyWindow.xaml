<Window x:Class="Pogget.VisualStudy.VisualStudyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pogget 视觉研究"
        Width="377"
        Height="468"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Border Width="353"
            Height="444"
            Margin="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            CornerRadius="15.5"
            Background="{StaticResource PoggetBodyBrush}"
            BorderBrush="#D9FFFFFF"
            BorderThickness="1.2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20.16"
                              ShadowDepth="5.12"
                              Direction="270"
                              Opacity="0.26"
                              Color="#33404A"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Height="50"
                    Margin="10,10,10,10"
                    VerticalAlignment="Top"
                    CornerRadius="9.2"
                    Background="{StaticResource PoggetTitleBrush}">
                <Grid Margin="18,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock VerticalAlignment="Center"
                               Foreground="#F0000000"
                               FontFamily="Segoe UI, Microsoft YaHei UI"
                               FontSize="19"
                               FontWeight="Bold"
                               FontStyle="Italic"
                               Text="近日待办"/>

                    <Button Grid.Column="1"
                            Width="32"
                            Height="32"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTip="更多">
                        <TextBlock FontFamily="Segoe Fluent Icons"
                                   FontSize="17"
                                   Foreground="#E6000000"
                                   Text="&#xE712;"/>
                    </Button>

                    <Button Grid.Column="2"
                            Width="28"
                            Height="32"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTip="折叠">
                        <TextBlock FontFamily="Segoe Fluent Icons"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="#E6000000"
                                   Text="&#xE70E;"/>
                    </Button>
                </Grid>
            </Border>

            <ItemsControl Grid.Row="1"
                          Margin="20,22,16,14"
                          ItemsSource="{Binding}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="75" Height="92">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="51"/>
                                <RowDefinition Height="41"/>
                            </Grid.RowDefinitions>

                            <Image Width="43"
                                   Height="43"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Top"
                                   Source="{Binding Icon}"
                                   Stretch="Uniform"/>

                            <TextBlock Grid.Row="1"
                                       Width="70"
                                       MaxHeight="38"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Top"
                                       Foreground="{StaticResource PoggetTextBrush}"
                                       FontSize="12.5"
                                       LineHeight="17"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding Name}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</Window>

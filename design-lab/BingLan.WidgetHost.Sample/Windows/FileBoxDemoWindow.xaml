<host:WidgetWindow x:Class="BingLan.WidgetHost.Sample.Windows.FileBoxDemoWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:host="clr-namespace:BingLan.WidgetHost.Wpf;assembly=BingLan.WidgetHost.Wpf"
                   Title="文件收纳透明宿主原型"
                   Width="353"
                   Height="444"
                    MinWidth="260"
                    MinHeight="280"
                    BackdropPreference="PoggetLike"
                    WidgetCornerRadius="15.5"
                    FontFamily="{StaticResource IceBlue.FontFamily}"
                   AllowDrop="True"
                   DragEnter="Window_DragEnter"
                   DragLeave="Window_DragLeave"
                   DragOver="Window_DragEnter"
                   Drop="Window_Drop">
    <Grid Background="{StaticResource IceBlue.BodyBrush}"
          ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Height="50"
                    Margin="10"
                    VerticalAlignment="Top"
                    CornerRadius="9.2"
                    Background="{StaticResource IceBlue.TitleBrush}">
                <Grid Margin="18,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Style="{StaticResource IceBlue.TitleText}"
                               Text="近日待办"/>

                    <Button x:Name="MoreButton"
                             Grid.Column="1"
                             Style="{StaticResource IceBlue.IconButton}"
                            DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type host:WidgetWindow}}}"
                             ToolTip="设置"
                             Click="MoreButton_Click">
                        <TextBlock FontFamily="Segoe Fluent Icons"
                                   FontSize="17"
                                   Text="&#xE712;"/>
                        <Button.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem x:Name="LockMenuItem"
                                          Header="锁定位置与大小"
                                          IsCheckable="True"
                                          Click="LockMenuItem_Click"/>
                                <Separator/>
                                <MenuItem x:Name="PoggetBackdropMenuItem"
                                          Header="Pogget 动态模糊"
                                          IsCheckable="True"
                                          IsChecked="True"
                                          Click="PoggetBackdropMenuItem_Click"/>
                                <MenuItem x:Name="AutoBackdropMenuItem"
                                          Header="Windows 系统磨砂"
                                          IsCheckable="True"
                                          Click="AutoBackdropMenuItem_Click"/>
                                <MenuItem x:Name="SolidBackdropMenuItem"
                                          Header="纯色回退"
                                          IsCheckable="True"
                                          Click="SolidBackdropMenuItem_Click"/>
                                <Separator/>
                                <MenuItem StaysOpenOnClick="True">
                                    <MenuItem.Header>
                                        <StackPanel Width="190">
                                            <TextBlock Margin="2,0,2,5"
                                                       Text="{Binding WidgetCornerRadius, StringFormat='窗口圆角：{0:0.#} DIP'}"/>
                                            <Slider x:Name="CornerRadiusSlider"
                                                    Minimum="0"
                                                    Maximum="32"
                                                    TickFrequency="1"
                                                    IsSnapToTickEnabled="True"
                                                    Value="{Binding WidgetCornerRadius, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="关闭组件"
                                          Click="CloseMenuItem_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Button Grid.Column="2"
                            Style="{StaticResource IceBlue.IconButton}"
                            Width="28"
                            ToolTip="折叠"
                            Click="CollapseButton_Click">
                        <TextBlock x:Name="CollapseGlyph"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Text="&#xE70E;"/>
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          Margin="20,22,16,14"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="FileList"
                              Width="300"
                              Margin="2.5,0,0,0"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Tile"
                                    Width="75"
                                    Height="92"
                                    CornerRadius="7"
                                    Background="Transparent"
                                    host:WidgetHitTest.IsInteractive="True"
                                    MouseLeftButtonDown="FileTile_MouseLeftButtonDown">
                                <Border.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="打开"
                                                  Click="OpenFileMenuItem_Click"/>
                                        <MenuItem Header="移除映射"
                                                  Click="RemoveFileMenuItem_Click"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="51"/>
                                        <RowDefinition Height="41"/>
                                    </Grid.RowDefinitions>

                                    <Image Width="48"
                                           Height="48"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Top"
                                           Source="{Binding Icon}"
                                           Stretch="Uniform"/>

                                    <TextBlock Grid.Row="1"
                                               Width="70"
                                               MaxHeight="38"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Top"
                                               Foreground="{StaticResource IceBlue.PrimaryTextBrush}"
                                               FontSize="12.5"
                                               LineHeight="17"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding Name}"
                                               ToolTip="{Binding Path}"/>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Tile"
                                         Property="IsMouseOver"
                                         Value="True">
                                    <Setter TargetName="Tile"
                                            Property="Background"
                                            Value="#28FFFFFF"/>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Border x:Name="Surface"
                CornerRadius="{Binding SurfaceCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type host:WidgetWindow}}}"
                Background="Transparent"
                BorderBrush="{StaticResource IceBlue.BorderBrush}"
                BorderThickness="1.2"
                IsHitTestVisible="False"/>
    </Grid>
</host:WidgetWindow>

<Window x:Class="BingLan.App.Windows.TextPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource IcePageBrush}"
        Foreground="{DynamicResource IceInkBrush}"
        FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource IceInkBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource IceInkBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SettingsInputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Foreground" Value="{DynamicResource IceInkBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SettingsButtonBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsButtonBorderBrush}"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24">
        <TextBlock x:Name="HeadingText" FontSize="19" FontWeight="SemiBold"/>
        <TextBlock x:Name="DescriptionText"
                   Margin="0,6,0,14"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource IceMutedInkBrush}"/>
        <TextBox x:Name="ValueEditor" Height="36"/>

        <StackPanel Margin="0,22,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Content="取消" IsCancel="True"/>
            <Button Margin="10,0,0,0"
                    Content="确定"
                    IsDefault="True"
                    Foreground="{DynamicResource IceActionTextBrush}"
                    Background="{DynamicResource IceActionBrush}"
                    BorderBrush="{DynamicResource IceActionBrush}"
                    Click="Confirm_Click"/>
        </StackPanel>
    </StackPanel>
</Window>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:BingLan.App.Windows">
    <!-- Windows 11 style controls for the settings window. Every colour is a theme resource,
         so the high contrast palette in AccessibilityThemeManager covers all of them. -->
    <FontFamily x:Key="SettingsIconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="SettingsFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3"
                            BorderBrush="{DynamicResource IceInkBrush}"
                            BorderThickness="2"
                            CornerRadius="8"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>
    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource IceMutedInkBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource IceMutedInkBrush}"/>
        <Setter Property="Margin" Value="6,22,0,7"/>
    </Style>
    <Style x:Key="CaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource IceMutedInkBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="Foreground" Value="{DynamicResource IceMutedInkBrush}"/>
    </Style>
    <Style x:Key="ValueTextStyle" TargetType="TextBlock">
        <Setter Property="MinWidth" Value="44"/>
        <Setter Property="Margin" Value="10,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="Foreground" Value="{DynamicResource IceMutedInkBrush}"/>
    </Style>

    <!-- Surfaces -->
    <Style x:Key="SettingsPanelStyle" TargetType="Border">
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="Background" Value="{DynamicResource SettingsSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SettingsSurfaceBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <Style TargetType="local:SettingsRow">
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="MinHeight" Value="54"/>
        <Setter Property="GlyphBrush" Value="{DynamicResource SettingsIconBlueBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SettingsRow">
                    <Grid Background="Transparent">
                        <Rectangle x:Name="Divider"
                                   Height="1"
                                   Margin="56,0,0,0"
                                   VerticalAlignment="Top"
                                   Fill="{DynamicResource SettingsSurfaceBorderBrush}"/>
                        <Grid x:Name="Body" Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="GlyphTile"
                                    Width="28"
                                    Height="28"
                                    Margin="0,0,14,0"
                                    VerticalAlignment="Center"
                                    Background="{TemplateBinding GlyphBrush}"
                                    CornerRadius="7">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource SettingsIconFont}"
                                           FontSize="15"
                                           Foreground="{DynamicResource SettingsIconGlyphBrush}"
                                           Text="{TemplateBinding Glyph}"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Header}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="DescriptionText"
                                           Margin="0,2,0,0"
                                           Style="{StaticResource CaptionStyle}"
                                           Text="{TemplateBinding Description}"/>
                            </StackPanel>
                            <ContentPresenter Grid.Column="2"
                                              Margin="20,0,0,0"
                                              VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Glyph" Value="">
                            <Setter TargetName="GlyphTile" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Divider" Property="Margin" Value="14,0,0,0"/>
                        </Trigger>
                        <Trigger Property="Description" Value="">
                            <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Body" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A setting that only matters under the row above it: lined up with that row's title. -->
    <Style x:Key="NestedSettingsRowStyle" TargetType="local:SettingsRow"
           BasedOn="{StaticResource {x:Type local:SettingsRow}}">
        <Setter Property="Padding" Value="56,8,14,8"/>
        <Setter Property="MinHeight" Value="48"/>
    </Style>

    <Style TargetType="local:SettingsGroup">
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Continue"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SettingsGroup">
                    <Border Background="{DynamicResource SettingsSurfaceBrush}"
                            BorderBrush="{DynamicResource SettingsSurfaceBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Border ClipToBounds="True">
                            <ItemsPresenter Margin="0,-1,0,0"/>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Buttons -->
    <Style TargetType="Button">
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="14,5"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}"/>
        <Setter Property="Foreground" Value="{DynamicResource IceInkBrush}"/>
        <Setter Property="Background" Value="{DynamicResource SettingsControlBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SettingsControlBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource SettingsControlHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource SettingsSegmentTrackBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{DynamicResource IceActionTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource IceActionBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource IceActionBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Check box: real multiple choice, such as file types. -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource IceInkBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Background="Transparent" Orientation="Horizontal">
                        <Border x:Name="Box"
                                Width="20"
                                Height="20"
                                VerticalAlignment="Center"
                                Background="{DynamicResource SettingsControlBrush}"
                                BorderBrush="{DynamicResource SettingsToggleOffBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <TextBlock x:Name="Mark"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource SettingsIconFont}"
                                       FontSize="12"
                                       Foreground="{DynamicResource IceActionTextBrush}"
                                       Text="&#xE73E;"
                                       Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource IceActionBrush}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource IceActionBrush}"/>
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- On/off settings: a switch with its state written next to it. -->
    <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Background="Transparent" Orientation="Horizontal">
                        <Border x:Name="Track"
                                Width="40"
                                Height="20"
                                VerticalAlignment="Center"
                                Background="{DynamicResource SettingsControlBrush}"
                                BorderBrush="{DynamicResource SettingsToggleOffBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <Ellipse x:Name="Thumb"
                                     Width="12"
                                     Height="12"
                                     Margin="4,0"
                                     HorizontalAlignment="Left"
                                     Fill="{DynamicResource SettingsToggleOffBrush}"/>
                        </Border>
                        <ContentPresenter x:Name="Label" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource IceActionBrush}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource IceActionBrush}"/>
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource IceActionTextBrush}"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Thumb" Property="Width" Value="14"/>
                            <Setter TargetName="Thumb" Property="Height" Value="14"/>
                            <Setter TargetName="Thumb" Property="Margin" Value="3,0"/>
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Radio buttons -->
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource IceInkBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Ring"
                                Width="20"
                                Height="20"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Background="{DynamicResource SettingsControlBrush}"
                                BorderBrush="{DynamicResource SettingsToggleOffBrush}"
                                BorderThickness="1"
                                CornerRadius="10"/>
                        <ContentPresenter Grid.Column="1"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource IceActionBrush}"/>
                            <Setter TargetName="Ring" Property="BorderThickness" Value="6"/>
                            <Setter TargetName="Ring" Property="Background" Value="{DynamicResource IceActionTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A few mutually exclusive words, shown as one segmented control. -->
    <Style x:Key="SegmentHostStyle" TargetType="Border">
        <Setter Property="Padding" Value="3"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Background" Value="{DynamicResource SettingsSegmentTrackBrush}"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style x:Key="SegmentRadioStyle" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
        <Setter Property="Foreground" Value="{DynamicResource IceMutedInkBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Segment"
                            Padding="14,5"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource IceInkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Segment" Property="Background" Value="{DynamicResource SettingsSurfaceBrush}"/>
                            <Setter TargetName="Segment" Property="BorderBrush" Value="{DynamicResource SettingsSurfaceBorderBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource IceInkBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A larger choice with a picture or several lines, such as desktop modes and layouts. -->
    <Style x:Key="ChoiceCardStyle" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Card"
                                Padding="10"
                                Background="{DynamicResource SettingsSurfaceBrush}"
                                BorderBrush="{DynamicResource SettingsSurfaceBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ContentPresenter/>
                        </Border>
                        <Border x:Name="Badge"
                                Width="22"
                                Height="22"
                                Margin="0,6,6,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="{DynamicResource IceActionBrush}"
                                CornerRadius="11"
                                Visibility="Collapsed">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource SettingsIconFont}"
                                       FontSize="11"
                                       Foreground="{DynamicResource IceActionTextBrush}"
                                       Text="&#xE73E;"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource SettingsSurfaceHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource SettingsChoiceSelectedBrush}"/>
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource IceActionBrush}"/>
                            <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                            <Setter TargetName="Card" Property="Padding" Value="9"/>
                            <Setter TargetName="Badge" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text input -->
    <Style TargetType="TextBox">
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource IceInkBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource IceInkBrush}"/>
        <Setter Property="Background" Value="{DynamicResource SettingsControlBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SettingsControlBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Field"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource IceActionBrush}"/>
                            <Setter TargetName="Field" Property="BorderThickness" Value="1,1,1,2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Field" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Drop-down lists -->
    <Style x:Key="ComboBoxToggleStyle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome"
                            Background="{DynamicResource SettingsControlBrush}"
                            BorderBrush="{DynamicResource SettingsControlBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <TextBlock Margin="0,0,11,0"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource SettingsIconFont}"
                                   FontSize="11"
                                   Foreground="{DynamicResource IceMutedInkBrush}"
                                   Text="&#xE70D;"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SettingsControlHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="Foreground" Value="{DynamicResource IceInkBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource ComboBoxToggleStyle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter Margin="11,0,32,0"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               PopupAnimation="Fade">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Margin="0,4,0,0"
                                    Padding="4"
                                    Background="{DynamicResource SettingsControlBrush}"
                                    BorderBrush="{DynamicResource SettingsControlBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <ScrollViewer>
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Foreground" Value="{DynamicResource IceInkBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Item"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            CornerRadius="4">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Item" Property="Background" Value="{DynamicResource SettingsSurfaceHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Item" Property="Background" Value="{DynamicResource SettingsNavSelectedBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource SettingsNavSelectedTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sliders -->
    <ControlTemplate x:Key="SliderFilledTemplate" TargetType="RepeatButton">
        <Border Height="4" Background="{DynamicResource IceActionBrush}" CornerRadius="2"/>
    </ControlTemplate>
    <ControlTemplate x:Key="SliderRemainderTemplate" TargetType="RepeatButton">
        <Border Height="4" Background="{DynamicResource SettingsTrackBrush}" CornerRadius="2"/>
    </ControlTemplate>
    <ControlTemplate x:Key="SliderThumbTemplate" TargetType="Thumb">
        <Grid Width="20" Height="20">
            <Ellipse Fill="{DynamicResource SettingsSurfaceBrush}"
                     Stroke="{DynamicResource SettingsControlBorderBrush}"
                     StrokeThickness="1"/>
            <Ellipse x:Name="Core"
                     Width="10"
                     Height="10"
                     Fill="{DynamicResource IceActionBrush}"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Core" Property="Width" Value="12"/>
                <Setter TargetName="Core" Property="Height" Value="12"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style TargetType="Slider">
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                              Focusable="False"
                                              Template="{StaticResource SliderFilledTemplate}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Template="{StaticResource SliderThumbTemplate}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                              Focusable="False"
                                              Template="{StaticResource SliderRemainderTemplate}"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thin scroll bars -->
    <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{DynamicResource SettingsToggleOffBrush}" CornerRadius="3" Opacity="0.45"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" Margin="2" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ScrollBarThumbStyle}"/>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" Margin="2">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Lists -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource SettingsControlBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SettingsControlBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Foreground" Value="{DynamicResource IceInkBrush}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ScrollViewer Focusable="False">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="Foreground" Value="{DynamicResource IceInkBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Item"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Item" Property="Background" Value="{DynamicResource SettingsSurfaceHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Item" Property="Background" Value="{DynamicResource SettingsNavSelectedBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource SettingsNavSelectedTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Navigation -->
    <Style x:Key="NavigationItemStyle" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="Foreground" Value="{DynamicResource IceInkBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Item"
                            Height="38"
                            Padding="7,0,8,0"
                            Background="Transparent"
                            CornerRadius="8">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Item" Property="Background" Value="{DynamicResource SettingsSegmentTrackBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Item" Property="Background" Value="{DynamicResource IceActionBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource IceActionTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavigationTileStyle" TargetType="Border">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Margin" Value="0,0,11,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="CornerRadius" Value="7"/>
    </Style>
    <Style x:Key="NavigationGlyphStyle" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontFamily" Value="{StaticResource SettingsIconFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource SettingsIconGlyphBrush}"/>
    </Style>

    <Style x:Key="ButtonGlyphStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontFamily" Value="{StaticResource SettingsIconFont}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
</ResourceDictionary>

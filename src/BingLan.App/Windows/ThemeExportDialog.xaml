<Window x:Class="BingLan.App.Windows.ThemeExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导出主题"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource IcePageBrush}"
        Foreground="{DynamicResource IceInkBrush}"
        FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource IceInkBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource IceInkBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SettingsInputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Foreground" Value="{DynamicResource IceInkBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SettingsButtonBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsButtonBorderBrush}"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24">
        <TextBlock FontSize="19" FontWeight="SemiBold" Text="导出主题"/>
        <TextBlock Margin="0,6,0,0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource IceMutedInkBrush}"
                   Text="主题包保存视觉样式和相对布局，可分享给其他电脑。"/>

        <TextBlock Margin="0,18,0,6" Text="主题名称"/>
        <TextBox x:Name="ThemeNameEditor"
                 Height="36"
                 AutomationProperties.Name="主题名称"
                 Text="我的冰蓝主题"/>

        <TextBlock Margin="0,18,0,6" FontWeight="SemiBold" Text="将包含"/>
        <TextBlock TextWrapping="Wrap"
                   Text="组件的颜色、材质、圆角、字号、显示开关、相对布局、整体风格（文字阴影、吸附间距、Dock 动效、任务栏透明或模糊）、Dock 应用槽位及其自定义图标，和一张示意预览图。"/>

        <TextBlock Margin="0,12,0,6" FontWeight="SemiBold" Text="不包含"/>
        <TextBlock TextWrapping="Wrap"
                   Foreground="{DynamicResource IceMutedInkBrush}"
                   Text="称呼、天气城市、待办、便签、文件映射、本机路径、壁纸、字体和任何截图。"/>

        <StackPanel Margin="0,22,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button x:Name="CancelButton"
                    Content="取消"
                    IsCancel="True"
                    Click="Cancel_Click"/>
            <Button x:Name="ConfirmButton"
                    Margin="10,0,0,0"
                    Content="下一步：选择保存位置"
                    IsDefault="True"
                    Foreground="{DynamicResource IceActionTextBrush}"
                    Background="{DynamicResource IceActionBrush}"
                    BorderBrush="{DynamicResource IceActionBrush}"
                    Click="Confirm_Click"/>
        </StackPanel>
    </StackPanel>
</Window>

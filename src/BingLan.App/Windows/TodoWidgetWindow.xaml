<local:WidgetWindowBase x:Class="BingLan.App.Windows.TodoWidgetWindow"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:local="clr-namespace:BingLan.App.Windows"
                        Title="待办便签"
                        Width="286"
                        Height="336"
                        MinWidth="226"
                        MinHeight="166"
                        WindowStyle="None"
                        ResizeMode="CanResize"
                        AllowsTransparency="True"
                        Background="Transparent"
                        ShowInTaskbar="False"
                        FontFamily="{StaticResource UiFont}"
                        Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid x:Name="BodySurface"
          Background="{Binding WidgetBackgroundBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
          ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="44"/>
            </Grid.RowDefinitions>

            <Border x:Name="TitleBarSurface"
                    Height="50"
                    Margin="10,10,10,0"
                    VerticalAlignment="Top"
                    Background="{Binding WidgetHeaderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                    CornerRadius="{Binding HeaderCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}">
                <Grid Margin="17,0,9,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TitleEditor"
                             AutomationProperties.Name="待办组件标题"
                             Style="{StaticResource DesktopContentTitleStyle}"
                             Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                             FontFamily="{Binding WidgetTitleFontFamily, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                             FontWeight="{Binding WidgetTitleFontWeight, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                             FontStyle="{Binding WidgetTitleFontStyle, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                             Text="{Binding Title, Mode=OneTime}"/>
                    <Button Grid.Column="1"
                            AutomationProperties.Name="打开待办组件设置"
                            Style="{StaticResource WidgetSettingsButtonStyle}"
                            Width="30"
                            Height="28"
                            Padding="0"
                            Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="16"
                            Content="•••"
                            ToolTip="设置"
                            Click="Settings_Click"/>
                    <Button Grid.Column="2"
                            AutomationProperties.Name="新增待办"
                            Width="30"
                            Height="28"
                            Margin="3,0,0,0"
                            Padding="0"
                            Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                            Background="{DynamicResource WidgetSubtleControlBrush}"
                            BorderBrush="{DynamicResource WidgetSubtleControlBorderBrush}"
                            FontSize="20"
                            Content="+"
                             ToolTip="新增待办"
                             Click="Add_Click"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          Margin="10,9,6,4"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="TodoList"
                              Focusable="False"
                              IsTabStop="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Tag="Interactive"
                                    Margin="2,2,6,3"
                                    Padding="8,8"
                                    CornerRadius="{Binding ItemCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                                    Background="{DynamicResource WidgetItemSurfaceBrush}">
                                <Border.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="上移" Click="MoveUp_Click"/>
                                        <MenuItem Header="下移" Click="MoveDown_Click"/>
                                        <Separator/>
                                        <MenuItem Header="删除" Click="DeleteTodo_Click"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="27"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox VerticalAlignment="Center"
                                              AutomationProperties.Name="切换待办完成状态"
                                              IsChecked="{Binding IsCompleted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Checked="Completion_Changed"
                                              Unchecked="Completion_Changed"/>
                                    <TextBox Grid.Column="1"
                                             AutomationProperties.Name="待办内容"
                                             MinHeight="24"
                                             VerticalContentAlignment="Center"
                                             FontSize="14"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="False"
                                             Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             GotKeyboardFocus="TodoText_GotKeyboardFocus"
                                             LostFocus="TodoText_LostFocus"
                                             KeyDown="TodoText_KeyDown">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                <Setter Property="Foreground"
                                                        Value="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                        <Setter Property="Foreground"
                                                                Value="{Binding WidgetSecondaryTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"/>
                                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <TextBlock Grid.Column="1"
                                               Margin="4,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="14"
                                               IsHitTestVisible="False"
                                               Text="输入待办…"
                                               Foreground="{Binding WidgetSecondaryTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Text}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- The negative margin gives a 32 DIP target without making the row taller. -->
                                    <Button Grid.Column="2"
                                            AutomationProperties.Name="删除待办"
                                            Width="32"
                                            Height="32"
                                            Margin="2,-4,-4,-4"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            Foreground="{Binding WidgetSecondaryTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontSize="16"
                                            Content="×"
                                            ToolTip="删除待办"
                                            Click="DeleteTodo_Click"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="17,0,17,7">
                <TextBlock x:Name="SummaryText"
                           AutomationProperties.LiveSetting="Polite"
                           VerticalAlignment="Center"
                           Foreground="{Binding WidgetSecondaryTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                           FontSize="12"/>
                <!-- The two footer buttons appear only under the mouse or with keyboard focus. -->
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Opacity" Value="0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                </DataTrigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button x:Name="ClearCompletedButton"
                            AutomationProperties.Name="清理已完成的待办"
                            Margin="0,0,6,0"
                            Padding="9,3"
                            Content="清理已完成"
                            Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                            Background="{DynamicResource WidgetControlBrush}"
                            BorderBrush="{DynamicResource WidgetControlBorderBrush}"
                            FontSize="11"
                            Click="ClearCompleted_Click"/>
                    <Button x:Name="CompletedVisibilityButton"
                            AutomationProperties.Name="切换已完成待办的显示状态"
                            Padding="9,3"
                            Content="隐藏已完成"
                            Foreground="{Binding WidgetTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                            Background="{DynamicResource WidgetControlBrush}"
                            BorderBrush="{DynamicResource WidgetControlBorderBrush}"
                            FontSize="11"
                            Click="ToggleCompletedVisibility_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
        <Border x:Name="Surface"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                CornerRadius="{Binding SurfaceCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:WidgetWindowBase}}}"
                IsHitTestVisible="False"/>
    </Grid>
</local:WidgetWindowBase>

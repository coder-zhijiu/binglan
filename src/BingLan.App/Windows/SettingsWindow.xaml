                                            Height="34"
                                            CornerRadius="8"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource SettingsInputBorderBrush}"/>
                                    <TextBox x:Name="DockColorEditor"
                                             Width="120"
                                             Height="34"
                                             Margin="10,0,0,0"
                                             AutomationProperties.Name="Dock 颜色"
                                             LostFocus="DockColorEditor_Commit"
                                             KeyDown="DockColorEditor_KeyDown"/>
                                    <Button Margin="10,0,0,0" Content="选择颜色…" Click="DockChooseColor_Click"/>
                                </StackPanel>
                                <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                    <TextBlock Width="72" VerticalAlignment="Center" Text="不透明度"/>
                                    <Slider x:Name="DockOpacitySlider"
                                            Width="300"
                                            Minimum="0"
                                            Maximum="1"
                                            SmallChange="0.02"
                                            LargeChange="0.1"
                                            AutomationProperties.Name="Dock 不透明度"
                                            ValueChanged="DockOpacity_Changed"/>
                                    <TextBlock x:Name="DockOpacityText"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="0,18,0,8"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Text="固定的应用"/>
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <ListBox x:Name="DockPinnedList"
                                     MinHeight="96"
                                     MaxHeight="300"
                                     AutomationProperties.Name="固定的应用"
                                     Background="{DynamicResource SettingsInputBrush}"
                                     BorderBrush="{DynamicResource SettingsInputBorderBrush}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}"/>
                                            <TextBlock Margin="0,2,0,0"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource IceMutedInkBrush}"
                                                       Text="{Binding Detail}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="DockPinnedEmptyText"
                                       Margin="0,8,0,0"
                                       Foreground="{DynamicResource IceMutedInkBrush}"
                                       Text="还没有固定的应用。"/>
                            <WrapPanel Margin="0,12,0,0">
                                <Button Content="添加应用…" Click="AddDockApp_Click"/>
                                <Button Margin="8,0,0,0" Content="导入任务栏应用" Click="ImportTaskbarPins_Click"/>
                                <Button Margin="8,0,0,0" Content="上移" Click="MoveDockAppUp_Click"/>
                                <Button Margin="8,0,0,0" Content="下移" Click="MoveDockAppDown_Click"/>
                                <Button Margin="8,0,0,0" Content="取消固定" Click="UnpinDockApp_Click"/>
                            </WrapPanel>
                            <TextBlock Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource IceMutedInkBrush}"
                                       Text="也可以把程序或快捷方式拖到 Dock 上，或在 Dock 中右键正在运行的应用选择“固定到 Dock”；拖动图标可调整顺序。"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="0,18,0,8"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Text="不在 Dock 中显示的应用"/>
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <ListBox x:Name="DockHiddenList"
                                     MinHeight="64"
                                     MaxHeight="200"
                                     AutomationProperties.Name="不在 Dock 中显示的应用"
                                     Background="{DynamicResource SettingsInputBrush}"
                                     BorderBrush="{DynamicResource SettingsInputBorderBrush}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}"/>
                                            <TextBlock Margin="0,2,0,0"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource IceMutedInkBrush}"
                                                       Text="{Binding Detail}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="DockHiddenEmptyText"
                                       Margin="0,8,0,0"
                                       Foreground="{DynamicResource IceMutedInkBrush}"
                                       Text="没有隐藏的应用。"/>
                            <WrapPanel Margin="0,12,0,0">
                                <Button Content="恢复显示" Click="UnhideDockApp_Click"/>
                            </WrapPanel>
                            <TextBlock Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource IceMutedInkBrush}"
                                       Text="在 Dock 中右键正在运行的应用，选择“不在 Dock 中显示此应用”，它的窗口就不再出现在 Dock 上。适合悬浮条、小工具这类不在任务栏显示的窗口。"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="DockStatusText"
                               Margin="0,14,0,4"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="{DynamicResource IceMutedInkBrush}"/>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="TaskbarPage"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock FontSize="26" FontWeight="SemiBold" Text="Windows 任务栏"/>
                    <TextBlock Margin="0,5,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource IceMutedInkBrush}"
                               Text="只调整 Windows 任务栏的外观和显示方式；开始菜单、系统托盘、通知和任务栏按钮保持不变。"/>

                    <Border Margin="0,18,0,0" Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <RadioButton x:Name="TaskbarDefaultRadio"
                                         GroupName="TaskbarMode"
                                         Tag="SystemDefault"
                                         Content="保持系统默认"
                                         Checked="TaskbarMode_Checked"/>
                            <RadioButton x:Name="TaskbarTransparentRadio"
                                         Margin="0,14,0,0"
                                         GroupName="TaskbarMode"
                                         Tag="Transparent"
                                         Content="透明"
                                         Checked="TaskbarMode_Checked"/>
                            <TextBlock Margin="22,2,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource IceMutedInkBrush}"
                                       Text="显示任务栏后方的背景。需要开启 Windows 透明效果；不支持时保持系统默认。"/>
                            <RadioButton x:Name="TaskbarBlurRadio"
                                         Margin="0,14,0,0"
                                         GroupName="TaskbarMode"
                                         Tag="Blur"
                                         Content="模糊"
                                         Checked="TaskbarMode_Checked"/>
                            <TextBlock Margin="22,2,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource IceMutedInkBrush}"
                                       Text="使用系统模糊材质，效果随 Windows 版本变化。需要开启 Windows 透明效果。"/>
                            <RadioButton x:Name="TaskbarSmartHideRadio"
                                         Margin="0,14,0,0"
                                         GroupName="TaskbarMode"
                                         Tag="SmartHide"
                                         Content="自动隐藏"
                                         Checked="TaskbarMode_Checked"/>
                            <TextBlock Margin="22,2,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource IceMutedInkBrush}"
                                       Text="任务栏平时隐藏，鼠标移到屏幕边缘时显示。与冰蓝 Dock 一起使用时接近苹果式桌面。"/>
                            <CheckBox x:Name="RevealOnlyAtCornersCheckBox"
                                      Margin="0,16,0,0"
                                      AutomationProperties.Name="只在屏幕左下角或右下角唤出任务栏"
                                      Content="只在屏幕左下角或右下角唤出任务栏"
                                      Click="RevealOnlyAtCorners_Click"/>
                            <TextBlock Margin="22,2,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource IceMutedInkBrush}"
                                       Text="任务栏在底部自动隐藏时生效：鼠标碰到底边中间不再弹出任务栏，移到底边左右两端才弹出；全屏应用运行时暂停。不修改 Windows 设置，取消勾选即恢复。"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="TaskbarStatusText"
                               Margin="0,14,0,0"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="{DynamicResource IceInkBrush}"/>
                    <TextBlock Margin="0,8,0,4"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource IceMutedInkBrush}"
                               Text="退出冰蓝桌面时恢复系统默认；程序异常退出后，下次启动时恢复。"/>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="PrivacyPage"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock FontSize="26" FontWeight="SemiBold" Text="隐私与启动"/>

                    <Border Margin="0,18,0,0" Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <CheckBox x:Name="StartupCheckBox"
                                      AutomationProperties.Name="登录 Windows 时启动冰蓝桌面"
                                      Content="登录 Windows 时启动冰蓝桌面"
                                      Checked="StartupCheckBox_Changed"
                                      Unchecked="StartupCheckBox_Changed"/>
                            <TextBlock x:Name="StartupNoteText"
                                       Margin="22,4,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource IceMutedInkBrush}"
                                       Text="只添加一个当前用户的启动项，不需要管理员权限。"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="0,18,0,8"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Text="数据与网络"/>
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap"
                                       Text="待办、便签、文件映射、Dock 固定应用和各项设置只保存在本机："/>
                            <TextBlock x:Name="DataDirectoryText"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource IceMutedInkBrush}"/>
                            <TextBlock Margin="0,12,0,0"
                                       TextWrapping="Wrap"
                                       Text="只有搜索天气城市和刷新天气时联网，发送的是搜索关键词或所选城市坐标；不使用 IP、GPS 或 Wi-Fi 定位。"/>
                            <TextBlock Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Text="不收集使用数据，不上传待办、文件路径、应用列表或窗口标题。"/>
                            <Button Margin="0,14,0,0"
                                    HorizontalAlignment="Left"
                                    Content="打开数据目录"
                                    Click="OpenDataDirectory_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="BackupPage"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock FontSize="26" FontWeight="SemiBold" Text="备份与导入"/>
                    <TextBlock Margin="0,5,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource IceMutedInkBrush}"
                               Text="备份包含全部桌面组件、个人内容和设置，只保存在本机数据目录的 Backups 文件夹。"/>

                    <Border Margin="0,18,0,0" Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <ListBox x:Name="BackupList"
                                     MinHeight="96"
                                     MaxHeight="300"
                                     AutomationProperties.Name="已有备份"
                                     Background="{DynamicResource SettingsInputBrush}"
                                     BorderBrush="{DynamicResource SettingsInputBorderBrush}"
                                     DisplayMemberPath="Label"/>
                            <TextBlock x:Name="BackupEmptyText"
                                       Margin="0,8,0,0"
                                       Foreground="{DynamicResource IceMutedInkBrush}"
                                       Text="还没有备份。"/>
                            <WrapPanel Margin="0,12,0,0">
                                <Button Content="立即备份" Click="CreateBackup_Click"/>
                                <Button Margin="8,0,0,0" Content="从备份恢复…" Click="RestoreBackup_Click"/>
                            </WrapPanel>
                            <TextBlock Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource IceMutedInkBrush}"
                                       Text="恢复前会先备份当前状态，然后重新启动冰蓝桌面。"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="0,18,0,8"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Text="主题包"/>
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap"
                                       Text="主题包包含组件的颜色、材质、圆角、字号、显示开关、相对布局和 Dock 应用槽位，可分享给其他电脑。"/>
                            <TextBlock Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource IceMutedInkBrush}"
                                       Text="不包含称呼、天气城市、待办、便签、文件映射和本机路径，也不包含壁纸和字体；导入后 Dock 应用会对应到本机已安装的同类应用。"/>
                            <WrapPanel Margin="0,12,0,0">
                                <Button Content="导出主题…" Click="ExportTheme_Click"/>
                                <Button Margin="8,0,0,0" Content="导入主题…" Click="ImportTheme_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="BackupStatusText"
                               Margin="0,14,0,4"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="{DynamicResource IceMutedInkBrush}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>

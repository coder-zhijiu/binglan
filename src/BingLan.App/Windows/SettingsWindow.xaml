<Window x:Class="BingLan.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="冰蓝桌面设置"
        Width="1180"
        Height="820"
        MinWidth="980"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource IcePageBrush}"
        Foreground="{DynamicResource IceInkBrush}"
        FontFamily="{StaticResource UiFont}"
        ShowInTaskbar="True">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource IceInkBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource IceInkBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SettingsInputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Foreground" Value="{DynamicResource IceInkBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SettingsButtonBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsButtonBorderBrush}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource IceInkBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource IceInkBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Background" Value="{DynamicResource IcePanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsPanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>
        <Style x:Key="ComponentListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card"
                                Padding="13,11"
                                Background="{DynamicResource SettingsCardBrush}"
                                BorderBrush="{DynamicResource SettingsCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="11">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource SettingsCardHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource SettingsCardSelectedBrush}"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource SettingsCardSelectedBorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SettingsCardSelectedTextBrush}"/>
                                <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Padding="18,24"
                Background="{DynamicResource SettingsNavigationBrush}"
                BorderBrush="{DynamicResource SettingsStrokeBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <Button x:Name="ExitAppButton"
                        DockPanel.Dock="Bottom"
                        Margin="8,12,8,0"
                        HorizontalAlignment="Stretch"
                        Content="退出冰蓝桌面"
                        Click="ExitApp_Click"/>
                <StackPanel DockPanel.Dock="Top" Margin="8,0,8,20">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="冰蓝桌面"/>
                    <TextBlock Margin="0,3,0,0"
                               Foreground="{DynamicResource IceMutedInkBrush}"
                               Text="一个应用，三套桌面"/>
                </StackPanel>
                <ListBox x:Name="SettingsNavigationList"
                         AutomationProperties.Name="设置类别"
                         BorderThickness="0"
                         Background="Transparent"
                         SelectionChanged="SettingsNavigationList_SelectionChanged"
                         SelectedIndex="0">
                    <ListBoxItem Content="主题与布局" Tag="Layout"/>
                    <ListBoxItem Content="桌面组件" Tag="Components"/>
                    <ListBoxItem Content="Dock" Tag="Dock"/>
                    <ListBoxItem Content="任务栏" Tag="Taskbar"/>
                    <ListBoxItem Content="隐私与启动" Tag="Privacy"/>
                    <ListBoxItem Content="备份与导入" Tag="Backup"/>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="28,24">
            <ScrollViewer x:Name="LayoutPage" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock FontSize="26" FontWeight="SemiBold" Text="主题与布局"/>
                    <TextBlock Margin="0,5,0,0"
                               Foreground="{DynamicResource IceMutedInkBrush}"
                               Text="这里只管理整套桌面的布局预设；单张卡片的显示、锁定、尺寸和外观统一放在“桌面组件”。"/>

                    <TextBlock Margin="0,18,0,8"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Text="桌面模式"/>
                    <TextBlock Margin="0,0,0,8"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource IceMutedInkBrush}"
                               Text="一次设置冰蓝 Dock 和 Windows 任务栏，不改变桌面卡片的位置。"/>
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <UniformGrid Columns="3">
                                <RadioButton x:Name="WindowsNativeModeRadio"
                                             AutomationProperties.Name="Windows 原生桌面模式"
                                             Margin="0,0,8,0"
                                             GroupName="DesktopMode"
                                             Tag="WindowsNative"
                                             Checked="DesktopMode_Checked">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="Windows 原生"/>
                                        <TextBlock Margin="0,2,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource IceMutedInkBrush}"
                                                   Text="关闭 Dock，任务栏保持系统默认。"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="IceBlueHybridModeRadio"
                                             AutomationProperties.Name="冰蓝混合桌面模式"
                                             Margin="4,0"
                                             GroupName="DesktopMode"
                                             Tag="IceBlueHybrid"
                                             Checked="DesktopMode_Checked">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="冰蓝混合"/>
                                        <TextBlock Margin="0,2,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource IceMutedInkBrush}"
                                                   Text="显示 Dock，任务栏透明或模糊。"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="AppleStyleModeRadio"
                                             AutomationProperties.Name="苹果式桌面模式"
                                             Margin="8,0,0,0"
                                             GroupName="DesktopMode"
                                             Tag="AppleStyle"
                                             Checked="DesktopMode_Checked">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="苹果式"/>
                                        <TextBlock Margin="0,2,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource IceMutedInkBrush}"
                                                   Text="显示 Dock，任务栏自动隐藏。"/>
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>
                            <TextBlock x:Name="DesktopModeStatusText"
                                       Margin="0,12,0,0"
                                       TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite"
                                       Foreground="{DynamicResource IceMutedInkBrush}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="0,18,0,8"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Text="清爽桌面"/>
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <CheckBox x:Name="CleanDesktopCheckBox"
                                      AutomationProperties.Name="隐藏 Windows 桌面图标"
                                      Content="隐藏 Windows 桌面图标"
                                      Checked="CleanDesktopCheckBox_Changed"
                                      Unchecked="CleanDesktopCheckBox_Changed"/>
                            <TextBlock Margin="22,4,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource IceMutedInkBrush}"
                                       Text="桌面文件保持原位，只隐藏图标。开启时在分组盒中加入此电脑、回收站、下载和桌面入口；关闭或退出冰蓝桌面时恢复图标。"/>
                            <TextBlock x:Name="CleanDesktopStatusText"
                                       Margin="22,8,0,0"
                                       TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite"
                                       Foreground="{DynamicResource IceInkBrush}"/>
                            <Button x:Name="CleanDesktopRetryButton"
                                    Margin="22,10,0,0"
                                    HorizontalAlignment="Left"
                                    Content="重新恢复"
                                    Visibility="Collapsed"
                                    Click="CleanDesktopRetry_Click"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="0,18,0,8"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Text="卡片外观"/>
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="GlassLightRadio"
                                             GroupName="GlassMode"
                                             Tag="Light"
                                             Content="浅色玻璃"
                                             Checked="Glass_Changed"/>
                                <RadioButton x:Name="GlassDarkRadio"
                                             Margin="22,0,0,0"
                                             GroupName="GlassMode"
                                             Tag="Dark"
                                             Content="深色玻璃"
                                             Checked="Glass_Changed"/>
                                <RadioButton x:Name="GlassClearRadio"
                                             Margin="22,0,0,0"
                                             GroupName="GlassMode"
                                             Tag="Clear"
                                             Content="无底板"
                                             Checked="Glass_Changed"/>
                            </StackPanel>
                            <StackPanel x:Name="GlassPalettePanel" Margin="0,14,0,0" Orientation="Horizontal">
                                <TextBlock Width="72" VerticalAlignment="Center" Text="配色"/>
                                <WrapPanel x:Name="GlassPaletteSwatches"/>
                            </StackPanel>
                            <StackPanel x:Name="GlassDensityPanel" Margin="0,14,0,0" Orientation="Horizontal">
                                <TextBlock Width="72" VerticalAlignment="Center" Text="玻璃浓度"/>
                                <Slider x:Name="GlassDensitySlider"
                                        Width="300"
                                        Minimum="0.05"
                                        Maximum="0.96"
                                        SmallChange="0.02"
                                        LargeChange="0.1"
                                        AutomationProperties.Name="玻璃浓度"
                                        ValueChanged="GlassDensity_Changed"/>
                                <TextBlock x:Name="GlassDensityText"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                                <TextBlock Width="72" VerticalAlignment="Center" Text="文字颜色"/>
                                <RadioButton x:Name="TextInkAutoRadio"
                                             GroupName="TextInk"
                                             Content="跟随外观"
                                             Checked="Glass_Changed"/>
                                <RadioButton x:Name="TextInkWhiteRadio"
                                             Margin="22,0,0,0"
                                             GroupName="TextInk"
                                             Content="白色（深色壁纸）"
                                             Checked="Glass_Changed"/>
                                <RadioButton x:Name="TextInkDarkRadio"
                                             Margin="22,0,0,0"
                                             GroupName="TextInk"
                                             Content="深色（浅色壁纸）"
                                             Checked="Glass_Changed"/>
                                <RadioButton x:Name="TextInkCustomRadio"
                                             Margin="22,0,0,0"
                                             GroupName="TextInk"
                                             Content="自定义"
                                             Checked="Glass_Changed"/>
                                <Button x:Name="CustomTextColorButton"
                                        Margin="8,0,0,0"
                                        Padding="6,2"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="选择文字颜色"
                                        ToolTip="选择文字颜色"
                                        Click="CustomTextColor_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="CustomTextColorChip"
                                                Width="14"
                                                Height="14"
                                                VerticalAlignment="Center"
                                                CornerRadius="7"
                                                BorderBrush="{DynamicResource SettingsResultBorderBrush}"
                                                BorderThickness="1"/>
                                        <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="选色…"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource IceMutedInkBrush}"
                                       Text="选择后应用到所有卡片，之后仍可在“桌面组件”页单独调整某张卡片。无底板时卡片只显示文字和图标，并自动加上柔和文字阴影。"/>
                            <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                                <Button Content="从 Rainmeter 皮肤导入外观…"
                                        AutomationProperties.Name="从 Rainmeter 皮肤导入外观"
                                        Click="ImportRainmeterLook_Click"/>
                                <TextBlock x:Name="RainmeterImportStatusText"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Polite"
                                           Foreground="{DynamicResource IceMutedInkBrush}"
                                           Text="只读取皮肤里的字体和颜色，不运行脚本或插件"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="0,18,0,8"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Text="整体风格"/>
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <UniformGrid Columns="3">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Margin="0,0,0,5" Text="文字阴影"/>
                                    <ComboBox x:Name="CardShadowSelector"
                                              Height="34"
                                              AutomationProperties.Name="文字阴影"
                                              SelectionChanged="StyleSelector_SelectionChanged">
                                        <ComboBoxItem Content="无" Tag="None"/>
                                        <ComboBoxItem Content="柔和" Tag="Soft"/>
                                        <ComboBoxItem Content="明显" Tag="Strong"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Margin="4,0">
                                    <TextBlock Margin="0,0,0,5" Text="吸附间距"/>
                                    <ComboBox x:Name="CardSpacingSelector"
                                              Height="34"
                                              AutomationProperties.Name="吸附间距"
                                              SelectionChanged="StyleSelector_SelectionChanged">
                                        <ComboBoxItem Content="紧凑（8）" Tag="8"/>
                                        <ComboBoxItem Content="标准（16）" Tag="16"/>
                                        <ComboBoxItem Content="宽松（24）" Tag="24"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Margin="0,0,0,5" Text="Dock 动效"/>
                                    <ComboBox x:Name="MotionSelector"
                                              Height="34"
                                              AutomationProperties.Name="Dock 动效"
                                              SelectionChanged="StyleSelector_SelectionChanged">
                                        <ComboBoxItem Content="标准" Tag="Standard"/>
                                        <ComboBoxItem Content="减弱" Tag="Reduced"/>
                                        <ComboBoxItem Content="关闭" Tag="Off"/>
                                    </ComboBox>
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource IceMutedInkBrush}"
                                       Text="文字阴影让卡片上的文字和图标更清楚；吸附间距是拖动卡片靠近其他卡片时保留的距离。任务栏透明或模糊在“任务栏”页设置。导出主题时一并保存。"/>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,18,0,0" Style="{StaticResource SectionCardStyle}">
                        <Border Height="322"
                                Background="{DynamicResource SettingsPreviewBrush}"
                                BorderBrush="{DynamicResource SettingsPreviewBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                ClipToBounds="True">
                            <Image x:Name="PresetPreviewImage"
                                   Stretch="Uniform"/>
                        </Border>
                    </Border>

                    <TextBlock Margin="0,18,0,8"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Text="布局预设"/>
                    <TextBlock Margin="0,0,0,8"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource IceMutedInkBrush}"
                               Text="改变桌面卡片的摆放位置，不影响 Dock 和任务栏；选中后点击“应用布局”。"/>
                    <UniformGrid Columns="4">
                        <RadioButton x:Name="QuietInformationPresetRadio"
                                     AutomationProperties.Name="静谧信息层布局"
                                     Margin="0,0,8,0"
                                     GroupName="LayoutPreset"
                                     Tag="QuietInformation"
                                     Checked="PresetRadio_Checked">
                            <StackPanel>
                                <Border Height="106" CornerRadius="10" ClipToBounds="True">
                                    <Image x:Name="QuietPresetThumb"
                                           Stretch="UniformToFill"/>
                                </Border>
                                <TextBlock Margin="0,7,0,0"
                                           HorizontalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Text="静谧信息层"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="GlacierWorkbenchPresetRadio"
                                     AutomationProperties.Name="冰川工作台布局"
                                     Margin="4,0"
                                     GroupName="LayoutPreset"
                                     Tag="GlacierWorkbench"
                                     Checked="PresetRadio_Checked">
                            <StackPanel>
                                <Border Height="106" CornerRadius="10" ClipToBounds="True">
                                    <Image x:Name="GlacierPresetThumb"
                                           Stretch="UniformToFill"/>
                                </Border>
                                <TextBlock Margin="0,7,0,0"
                                           HorizontalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Text="冰川工作台"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="TransparentApplePresetRadio"
                                     AutomationProperties.Name="通透苹果桌面布局"
                                     Margin="8,0,0,0"
                                     GroupName="LayoutPreset"
                                     Tag="TransparentApple"
                                     Checked="PresetRadio_Checked">
                            <StackPanel>
                                <Border Height="106" CornerRadius="10" ClipToBounds="True">
                                    <Image x:Name="ApplePresetThumb"
                                           Stretch="UniformToFill"/>
                                </Border>
                                <TextBlock Margin="0,7,0,0"
                                           HorizontalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Text="通透苹果桌面"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="CenterClockPresetRadio"
                                     AutomationProperties.Name="居中时钟布局"
                                     Margin="8,0,0,0"
                                     GroupName="LayoutPreset"
                                     Tag="CenterClock"
                                     Checked="PresetRadio_Checked">
                            <StackPanel>
                                <Border Height="106" CornerRadius="10" ClipToBounds="True">
                                    <Image x:Name="CenterClockPresetThumb"
                                           Stretch="UniformToFill"/>
                                </Border>
                                <TextBlock Margin="0,7,0,0"
                                           HorizontalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Text="居中时钟"/>
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>

                    <Grid Margin="0,18,0,4">
                        <TextBlock x:Name="LayoutStatusText"
                                   AutomationProperties.LiveSetting="Polite"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource IceMutedInkBrush}"/>
                        <Button x:Name="ApplyLayoutButton"
                                Width="132"
                                HorizontalAlignment="Right"
                                Foreground="{DynamicResource IceActionTextBrush}"
                                Background="{DynamicResource IceActionBrush}"
                                BorderBrush="{DynamicResource IceActionBrush}"
                                Content="应用布局"
                                Click="ApplyLayout_Click"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="ComponentsPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock FontSize="26" FontWeight="SemiBold" Text="桌面组件"/>
                    <TextBlock Margin="0,5,0,0"
                               Foreground="{DynamicResource IceMutedInkBrush}"
                               Text="选择一张卡片后，在右侧集中调整显示、锁定、尺寸、外观和对应内容；修改后立即生效。"/>
                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="新建："/>
                        <Button x:Name="AddTodoButton" Margin="8,0,0,0" Content="待办便签" Click="AddTodo_Click"/>
                        <Button x:Name="AddNoteButton" Margin="8,0,0,0" Content="普通便签" Click="AddNote_Click"/>
                        <Button x:Name="AddFileBoxButton" Margin="8,0,0,0" Content="桌面分组盒" Click="AddFileBox_Click"/>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Padding="14"
                            Background="{DynamicResource SettingsComponentNavigationBrush}"
                            BorderBrush="{DynamicResource SettingsComponentBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="4,2,4,12">
                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="我的桌面卡片"/>
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="{DynamicResource IceMutedInkBrush}"
                                           Text="可拖动 / 已锁定状态一目了然"/>
                            </StackPanel>
                            <ListBox x:Name="DesktopComponentList"
                                     AutomationProperties.Name="桌面组件列表"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ItemContainerStyle="{StaticResource ComponentListItemStyle}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     SelectionChanged="DesktopComponentList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1"
                                                       Margin="8,0,0,0"
                                                       Padding="7,2"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SettingsBadgeTextBrush}"
                                                       Background="{DynamicResource SettingsBadgeBrush}"
                                                       Text="{Binding Status}"/>
                                            <TextBlock Grid.Row="1"
                                                       Grid.ColumnSpan="2"
                                                       Margin="0,4,0,0"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource IceMutedInkBrush}"
                                                       Text="{Binding TypeName}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <ScrollViewer x:Name="ComponentDetailsScrollViewer"
                                  Grid.Column="2"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border x:Name="DisplayContentSettingsCard"
                                    Visibility="Collapsed"
                                    Margin="0,0,0,14"
                                    Style="{StaticResource SectionCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="时间与问候内容"/>
                                    <Grid Grid.Row="1" Margin="0,13,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="88"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="150"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" Text="问候称呼"/>
                                        <TextBox x:Name="GreetingNameEditor"
                                                 Grid.Column="1"
                                                 Height="36"
